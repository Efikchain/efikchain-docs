[Unit]
Description=Efikchain Mainnet Node
After=network-online.target

[Service]
User=efikcoin
ExecStart=/usr/local/bin/geth --datadir /home/efikcoin/.ethereum --networkid 1997 \
  --http --http.addr 0.0.0.0 --http.port 8545 \
  --http.api eth,net,web3 \
  --ws --ws.addr 0.0.0.0 --ws.api eth,net,web3 \
  --port 30303 --maxpeers 50 --cache 4096 \
  --http.corsdomain "*" --http.vhosts "*"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
